{
  "name": "n8n-nodes-solmarrow",
  "version": "0.1.0",
  "description": "SolMarrow for n8n: schedule and publish social media posts to 20 networks, and start workflows when a post is published or fails.",
  "keywords": [
    "n8n-community-node-package",
    "solmarrow",
    "social media",
    "scheduling",
    "social media scheduler"
  ],
  "license": "MIT",
  "homepage": "https://solmarrow.com/developers",
  "author": {
    "name": "shakil197",
    "email": "support@solmarrow.com",
    "url": "https://solmarrow.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shakil197/n8n-nodes-solmarrow.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SolMarrowOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SolMarrow/SolMarrow.node.js",
      "dist/nodes/SolMarrowTrigger/SolMarrowTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.54.6",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/Shakil197/n8n-nodes-solmarrow/issues"
  }
}
